# Copy to backend/.env and fill in. Never commit .env.

# Speech-to-text — https://console.deepgram.com
DEEPGRAM_API_KEY=

# LLM — openai (default, https://platform.openai.com) or anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=   (only if LLM_PROVIDER=anthropic)

# Text-to-speech — https://play.cartesia.ai
CARTESIA_API_KEY=
# Voice to speak with (copy an ID from play.cartesia.ai)
CARTESIA_VOICE_ID=a0e99841-438c-4a64-b679-ae501e7d6091

# Optional: require clients to pass ?token=... on /v1/session
RAPHAEL_TOKEN=

# Debug only: log what Deepgram heard in rejected wake-word bursts
# DEBUG_WAKE=1
